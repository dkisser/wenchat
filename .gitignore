node_modules/
dist/
# @yao-pkg/packer output (single-binary releases)
dist-release/
# Node SEA blob artifacts (in case we ever drop to raw SEA)
*.blob
# Top-level accidental packer output (safety net; packer normally writes to dist-release/)
/wenchat
/wenchat.exe
# Bun lockfile — kept on disk for reproducible `bun install` but intentionally
# untracked. Contributors regenerate locally; CI installs without --frozen-lockfile.
bun.lockb
# Internal design docs / plans / specs. Lives in-repo for the maintainer's
# reference but shouldn't be in the published history.
docs/superpowers/
*.log
.DS_Store
.env
