{
	"name": "wenchat",
	"description": "WenChat — LAN-only P2P terminal chat over WebRTC with mDNS auto-discovery",
	"keywords": [
		"wenchat",
		"webrtc",
		"p2p",
		"lan",
		"chat",
		"terminal",
		"tui",
		"mdns",
		"bonjour",
		"monorepo"
	],
	"license": "MIT",
	"private": true,
	"version": "0.1.1",
	"workspaces": ["apps/*", "packages/*"],
	"overrides": {
		"string-width": "4.2.3"
	},
	"scripts": {
		"build": "bun run --filter '*' build",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"cli": "tsx apps/cli/src/main.tsx",
		"package:cli": "bun scripts/package-cli.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.8.3",
		"@types/node": "^20.0.0",
		"@wenchat/cli": "workspace:*",
		"@wenchat/core": "workspace:*",
		"@wenchat/protocol": "workspace:*",
		"@wenchat/ui": "workspace:*",
		"@yao-pkg/pkg": "6.22.0",
		"bun-types": "1.3.14",
		"esbuild": "0.28.2",
		"tsx": "^4.19.0",
		"typescript": "^5.5.0"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"packageManager": "bun@1.3.14",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dkisser/wenchat.git"
	},
	"homepage": "https://github.com/dkisser/wenchat#readme",
	"bugs": {
		"url": "https://github.com/dkisser/wenchat/issues"
	}
}
